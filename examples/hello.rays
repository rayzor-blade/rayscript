// Types are optional; a variable holds any value.
function area(shape) {
  return switch (shape.kind) {
    case 'circle': 3.14159 * shape.r * shape.r;
    case 'rect': shape.w * shape.h;
    default: throw 'unknown shape ' + shape.kind;
  };
}

var shapes = [
  {kind: 'circle', r: 2},
  {kind: 'rect', w: 3, h: 4},
  {kind: 'triangle'},
];

var total = 0;
for (s in shapes) {
  try {
    total += area(s);
  } catch (e) {
    trace('skipped: $e');
  }
}

var counts = ['a' => 1, 'b' => 2];
counts['c'] = 3;
var names = [for (k => v in counts) '$k=$v'];

function counter() {
  var n = 0;
  return () -> ++n;
}
var next = counter();
next();

// A fiber runs alongside the caller; await waits for its result.
var slow = spawn(() -> { yield(); return 'done'; });

return {total: total, names: names, next: next(), fiber: await slow};
